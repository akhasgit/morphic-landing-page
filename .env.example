# Account dashboard (/account). The marketing pages need none of these.

# The Morphic API server (the morphic repo's server/). Used server-side only.
MORPHIC_API_URL=http://localhost:8787

# Optional, once there's a custom domain for the dashboard (e.g. account.example.com):
# /account/* then redirects there. Leave empty to serve the dashboard at <this site>/account.
ACCOUNT_HOST=

# The Google sign-in client comes from the API (/v1/config), so it isn't set here. In Google Cloud,
# add this site's origin (e.g. https://trymorphic.vercel.app) to the OAuth client's authorized JavaScript origins.
